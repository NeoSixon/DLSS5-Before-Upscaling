{
  "name": "dlss5-before-upscaling",
  "version": "1.0.0",
  "description": "Configure DLSS 5 Neural Rendering before the upscaling stage.",
  "main": "standalone/main.js",
  "scripts": {
    "start": "npm run start:standalone",
    "prestart:standalone": "npm run icon:standalone",
    "start:standalone": "electron standalone",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "electron scripts/test-standalone-library-ui.js",
    "icon": "npm run icon:standalone",
    "icon:standalone": "electron scripts/make-standalone-icon.js",
    "prebuild:standalone:portable": "npm run icon:standalone",
    "build:standalone:portable": "electron-builder --config standalone/electron-builder.json --win portable",
    "build:portable": "npm run build:standalone:portable"
  },
  "author": "NeoSixon",
  "license": "MIT",
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
