{
  "appId": "com.neosixon.dlss5beforeupscaling",
  "productName": "DLSS5 Before Upscaling",
  "directories": {
    "output": "dist-standalone"
  },
  "files": [
    "standalone/**/*",
    "package.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!standalone/electron-builder.json"
  ],
  "extraMetadata": {
    "name": "dlss5-before-upscaling",
    "version": "1.0.0",
    "description": "Configure DLSS 5 Neural Rendering before the upscaling stage.",
    "main": "standalone/main.js",
    "author": "NeoSixon",
    "license": "MIT"
  },
  "compression": "maximum",
  "asar": true,
  "win": {
    "target": [
      "portable"
    ],
    "icon": "build/icon.ico"
  },
  "portable": {
    "artifactName": "DLSS5-Before-Upscaling.${ext}"
  }
}
